[Unit]
Description=Pull jarnis/honeypot from Docker Hub and recreate if digest changed
Documentation=https://github.com/J-A-R-N-I-S/honeypot
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jarnis-honeypot-update
# Do not pass HONEYPOT_TOKEN here — token stays in ENV_FILE only.
Nice=10

[Install]
WantedBy=multi-user.target
